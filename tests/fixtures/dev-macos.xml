<domain type='kvm' xmlns:qemu='http://libvirt.org/schemas/domain/qemu/1.0'>
  <name>dev-mac</name>
  <memory unit='MiB'>8192</memory>
  <currentMemory unit='MiB'>4096</currentMemory>
  <vcpu placement='static'>4</vcpu>
  <sysinfo type='smbios'>
    <system>
      <entry name='manufacturer'>Apple Inc.</entry>
      <entry name='product'>MacPro7,1</entry>
      <entry name='version'>1.0</entry>
    </system>
    <baseBoard>
      <entry name='manufacturer'>Apple Inc.</entry>
      <entry name='product'>Mac-27AD2F918AE68F61</entry>
      <entry name='version'>1.0</entry>
    </baseBoard>
  </sysinfo>
  <os firmware='efi'>
    <type arch='x86_64' machine='pc-q35-11.1'>hvm</type>
    <firmware>
      <feature enabled='no' name='secure-boot'/>
      <feature enabled='no' name='enrolled-keys'/>
    </firmware>
    <smbios mode='sysinfo'/>
  </os>
  <features>
    <acpi/>
    <apic/>
  </features>
  <clock offset='utc'>
    <timer name='rtc' tickpolicy='catchup'/>
    <timer name='pit' tickpolicy='delay'/>
    <timer name='hpet' present='no'/>
  </clock>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>
  <devices>
    <emulator>qemu-system-x86_64</emulator>
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='/images/opencore.iso'/>
      <target dev='sda' bus='sata'/>
      <readonly/>
      <boot order='1'/>
    </disk>
    <disk type='block' device='disk'>
      <driver name='qemu' type='raw' cache='none' discard='unmap'/>
      <source dev='/dev/zvol/pool/vms/dev-mac'/>
      <target dev='sdb' bus='sata' rotation_rate='1'/>
      <blockio logical_block_size='4096' physical_block_size='4096'/>
      <serial>SYNTHETIC-DISK-2</serial>
      <boot order='2'/>
    </disk>
    <controller type='sata' index='0'/>
    <input type='keyboard' bus='ps2'/>
    <input type='mouse' bus='ps2'/>
    <audio id='1' type='none'/>
    <video>
      <model type='vmvga' vram='65536' heads='1' primary='yes'/>
    </video>
    <memballoon model='virtio' autodeflate='on' freePageReporting='on'>
      <stats period='10'/>
      <address type='pci' domain='0x0000' bus='0x00' slot='0x13' function='0x0'/>
    </memballoon>
  </devices>
  <qemu:commandline>
    <qemu:arg value='-device'/>
    <qemu:arg value='isa-applesmc,osk=test-osk'/>
    <qemu:arg value='-cpu'/>
    <qemu:arg value='Skylake-Client-v4,vendor=GenuineIntel,+invtsc,kvm=on'/>
  </qemu:commandline>
</domain>
